{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/hornerito/browser",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://backend-hornerito.vercel.app/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
